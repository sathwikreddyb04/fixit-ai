# FixIt AI Server Configuration
PORT=4000
NODE_ENV=development

# AI Provider Configuration
# Set to 'gemini' or leave blank for deterministic demo mode
AI_PROVIDER=demo

# Optional: Google Gemini API Key for real multimodal inference
# If left empty, FixIt AI will automatically and honestly run in Demo Mode
GEMINI_API_KEY=

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=5242880
